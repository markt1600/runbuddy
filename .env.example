# All optional — the app runs fully without any of them (library phrases +
# on-device speech synthesis). Set them in Vercel → Project → Settings →
# Environment Variables, or copy this file to .env.local for local dev.

# Live mid-run phrase generation + push-to-talk replies (Claude Sonnet 5).
# Get one at https://platform.claude.com → API Keys.
ANTHROPIC_API_KEY=

# Voicing generated phrases at runtime + batch-rendering the phrase library
# (npm run generate-library). Get one at https://elevenlabs.io → profile → API Keys.
ELEVENLABS_API_KEY=

# ElevenLabs voice IDs, one per persona. Find a voice's ID in the ElevenLabs
# dashboard (My Voices → ⋮ → Copy Voice ID). If unset, the placeholder stock
# voices in lib/personas.ts are used.
ELEVENLABS_VOICE_AHBENG=
ELEVENLABS_VOICE_COACH=
ELEVENLABS_VOICE_FLIRTY=
ELEVENLABS_VOICE_LOANSHARK=

# Auto-generated voice library at runtime: create a Blob store in Vercel
# (Storage → Create Database → Blob) and this token is injected automatically —
# don't set it by hand on Vercel. With it + the ElevenLabs key present, the app
# renders any missing phrases on first launch with an on-screen progress bar.
BLOB_READ_WRITE_TOKEN=

# Protects the admin page and the credit-spending endpoints (fresh-phrase
# generation, force re-render). Any string works; digits are easiest to type
# on a phone. Leave unset to keep admin open (local dev).
ADMIN_PIN=

# Weather (Open-Meteo) and reverse geocoding (BigDataCloud) are keyless — no
# variables needed for the location/weather-aware phrases.

# Google sign-in + run history. All three must be set or the app stays in
# guest-only mode (exactly the pre-accounts behaviour). Create an OAuth 2.0
# Client ID (Web application) at https://console.cloud.google.com/apis/credentials
# and add  https://<your-domain>/api/auth/callback  as an authorized redirect
# URI. AUTH_SECRET signs the session cookie and the per-user storage prefix —
# any long random string (e.g. `openssl rand -hex 32`); changing it signs
# everyone out and orphans saved runs, so set it once and keep it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SECRET=

# Hide the ⚙ Admin entry point from everyone but these Google accounts
# (comma-separated). Only takes effect when Google sign-in is configured —
# otherwise there'd be no way to be the admin at all. The ADMIN_PIN still
# guards the credit-spending endpoints; this controls visibility.
ADMIN_EMAIL=

# Spotify now-playing awareness (optional). Create an app at
# developer.spotify.com/dashboard, add <origin>/api/spotify/callback as a
# redirect URI, and allowlist each user's Spotify account under User
# Management (development-mode apps are limited to 25 named users). The
# trainer then sees what's playing mid-run and can react to it. Tokens are
# stored AES-sealed under AUTH_SECRET — changing that secret disconnects
# everyone's Spotify along with signing them out.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
